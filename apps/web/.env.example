# ─── App ───────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_TEST_ROUTES=true

# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# ─── Auth (Auth.js v5) ─────────────────────────────
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── Email (Resend) ────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ─── AI（OpenRouter）──
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# CHAT_MODEL=openai/gpt-oss-20b:free

# ─── Redis ──
REDIS_URL=redis://localhost:6379

# ─── Ingestion ─────────────────────────────────────
REMOTEOK_USER_AGENT=AI-Job-Market-Intelligence/1.0 (contact@yourdomain.com)

# ─── Stripe (B2C Subscription) ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
