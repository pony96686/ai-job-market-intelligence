# ─── App ───────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_TEST_ROUTES=true

# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# ─── Auth (Auth.js v5) ─────────────────────────────
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── Email (Resend) ────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ─── Redis ──
REDIS_URL=redis://localhost:6379

# ─── Stripe (B2C Subscription) ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# ─── AI (OpenRouter, cost-first) ────────────
# Career Coach (SSE Route Handler) is the only OpenRouter-calling code that
# runs in this app — Job Parsing/Scoring/Resume/GitHub parsing/Embedding all
# run in apps/worker instead, see apps/worker/.env.example for those.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Optional. Career Coach's own model, independent of Worker's CHAT_MODEL;
# unset falls back to the same free model.
CAREER_COACH_MODEL=openai/gpt-oss-20b:free
# Optional paid fallback model for Career Coach
# tried only after the free model's own retries are exhausted. Unset =
# fallback disabled, behavior identical to not having this feature at all.
# 2026-08 pricing snapshot picked for cost — verify current pricing/
# availability at openrouter.ai/models before relying on it.
CAREER_COACH_MODEL_FALLBACK=qwen/qwen3.7-plus   # multi-turn + tool calling, $0.32/$1.28 per M tokens
# Shared with apps/worker's own budget check — each process reads its own
OPENROUTER_FALLBACK_MIN_BALANCE_USD=1
# Optional. Per-completion token cap for Career Coach replies — the full
# answer is resolved before any of it streams to the client (not real
# token streaming), so too low a value truncates long-form asks (resume
# templates, cover letters) mid-generation instead of erroring. Unset
# defaults to 3000.
CAREER_COACH_MAX_TOKENS=3000
